{
    "name": "hiring-bull",
    "version": "0.0.1",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "start": "cross-env EXPO_NO_DOTENV=1 expo start",
        "prebuild": "cross-env EXPO_NO_DOTENV=1 bun expo prebuild",
        "android": "cross-env EXPO_NO_DOTENV=1 expo run:android",
        "dev": "cross-env EXPO_NO_DOTENV=1 expo run:android",
        "ios": "cross-env EXPO_NO_DOTENV=1 expo run:ios",
        "web": "cross-env EXPO_NO_DOTENV=1 expo start --web",
        "xcode": "xed -b ios",
        "doctor": "bunx expo-doctor@latest",
        "preinstall": "bunx only-allow bun",
        "start:staging": "cross-env APP_ENV=staging bun run start",
        "prebuild:staging": "cross-env APP_ENV=staging bun run prebuild",
        "prebuild:development": "cross-env APP_ENV=development bun run prebuild",
        "android:staging": "cross-env APP_ENV=staging bun run android",
        "ios:staging": "cross-env APP_ENV=staging bun run ios",
        "start:production": "cross-env APP_ENV=production bun run start",
        "prebuild:production": "cross-env APP_ENV=production bun run prebuild",
        "android:production": "cross-env APP_ENV=production bun run android",
        "ios:production": "cross-env APP_ENV=production bun run ios",
        "build:development:ios": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform ios",
        "build:development:android": "cross-env APP_ENV=development EXPO_NO_DOTENV=1 eas build --profile development --platform android ",
        "build:staging:ios": "cross-env APP_ENV=staging EXPO_NO_DOTENV=1 eas build --profile staging --platform ios",
        "build:staging:android": "cross-env APP_ENV=staging EXPO_NO_DOTENV=1 eas build --profile staging --platform android ",
        "build:production:ios": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform ios",
        "build:production:android": "cross-env APP_ENV=production EXPO_NO_DOTENV=1 eas build --profile production --platform android ",
        "prepare": "husky",
        "app-release": "cross-env SKIP_BRANCH_PROTECTION=true np --no-publish --no-cleanup --no-release-draft",
        "version": "bun run prebuild && git add .",
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
        "type-check": "tsc  --noemit",
        "lint:translations": "eslint ./src/translations/ --fix --ext .json  ",
        "test": "jest",
        "check-all": "bun run lint && bun run type-check && bun run lint:translations && bun run test",
        "test:ci": "bun run test --coverage",
        "test:watch": "bun run test --watch",
        "install-maestro": "curl -Ls 'https://get.maestro.mobile.dev' | bash",
        "e2e-test": "maestro test .maestro/ -e APP_ID=com.obytes.development"
    },
    "dependencies": {
        "@expo/metro-runtime": "^6.1.2",
        "@expo/vector-icons": "^15.1.1",
        "@gorhom/bottom-sheet": "^5.2.14",
        "@hookform/resolvers": "^3.10.0",
        "@react-native-google-signin/google-signin": "^16.1.2",
        "@react-navigation/native": "^7.2.4",
        "@shopify/flash-list": "2.0.2",
        "@tanstack/react-query": "^5.100.14",
        "axios": "^1.16.1",
        "expo": "^56.0.4",
        "expo-auth-session": "~7.0.11",
        "expo-constants": "~18.0.13",
        "expo-dev-client": "~6.0.21",
        "expo-device": "~8.0.10",
        "expo-font": "~14.0.11",
        "expo-image": "~3.0.11",
        "expo-linking": "~8.0.12",
        "expo-localization": "~17.0.8",
        "expo-notifications": "~0.32.17",
        "expo-router": "~6.0.23",
        "expo-secure-store": "^15.0.8",
        "expo-splash-screen": "~31.0.13",
        "expo-status-bar": "~3.0.9",
        "expo-system-ui": "~6.0.9",
        "expo-updates": "~29.0.17",
        "expo-web-browser": "~15.0.11",
        "i18next": "^23.16.8",
        "lodash.memoize": "^4.1.2",
        "nativewind": "^4.2.4",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-hook-form": "^7.76.1",
        "react-i18next": "^15.7.4",
        "react-native": "0.81.5",
        "react-native-edge-to-edge": "^1.8.1",
        "react-native-flash-message": "^0.4.2",
        "react-native-gesture-handler": "~2.28.0",
        "react-native-iap": "^14.7.20",
        "react-native-keyboard-controller": "^1.21.8",
        "react-native-mmkv": "~4.1.2",
        "react-native-nitro-modules": "^0.34.1",
        "react-native-pager-view": "^6.9.1",
        "react-native-reanimated": "~4.1.7",
        "react-native-restart": "0.0.27",
        "react-native-safe-area-context": "5.6.2",
        "react-native-screens": "^4.25.2",
        "react-native-svg": "~15.12.1",
        "react-native-web": "~0.21.2",
        "react-native-worklets": "^0.7.4",
        "react-query-kit": "^3.3.3",
        "tailwind-variants": "^0.2.1",
        "zod": "^3.25.76",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@dev-plugins/react-query": "^0.0.7",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@expo/config": "~12.0.13",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react-native": "^12.9.0",
        "@types/i18n-js": "^3.8.9",
        "@types/invariant": "^2.2.37",
        "@types/jest": "^29.5.14",
        "@types/lodash.memoize": "^4.1.9",
        "@types/react": "~19.1.17",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "@typescript-eslint/parser": "^8.59.4",
        "babel-plugin-module-resolver": "^5.0.3",
        "cross-env": "^7.0.3",
        "dotenv": "^16.6.1",
        "eslint": "^9.39.4",
        "eslint-config-expo": "^9.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-i18n-json": "^4.0.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react-compiler": "19.1.0-rc.2",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-tailwindcss": "^3.18.3",
        "eslint-plugin-testing-library": "^7.16.2",
        "eslint-plugin-unicorn": "^59.0.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-expo": "~54.0.17",
        "jest-junit": "^16.0.0",
        "lint-staged": "^15.5.2",
        "np": "^10.3.0",
        "prettier": "^3.8.3",
        "tailwindcss": "3.4.4",
        "ts-jest": "^29.4.11",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.4"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/user/repo-name.git"
    },
    "packageManager": "bun@10.30.1",
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "listUnknownPackages": false,
                "exclude": [
                    "react-native-restart"
                ]
            }
        },
        "install": {
            "exclude": [
                "eslint-config-expo",
                "react-native-worklets"
            ]
        }
    },
    "osMetadata": {
        "initVersion": "8.0.0"
    }
}
